# 복사해서 .env 로. 절대 커밋하지 않는다 (.gitignore).

# 1. 네이버 검색광고 API (searchad.naver.com → 도구 > API 사용 관리)
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=

# 6·10. 네이버 개발자센터 앱 (지역검색·뉴스검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 7. 구글 검색 (SerpAPI)
SERPAPI_KEY=

# 8. Google Places API (New)
GOOGLE_PLACES_KEY=

# 9·12. AI 엔진
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 3·5. 운산네트웍스 프록시 풀 (쉼표로 구분, http://user:pass@host:port)
PROXY_POOL=

# 알림 (선택)
SLACK_WEBHOOK=
